# iShifo — yagona muhit fayli (local + Docker Compose)
# cp .env.example .env
#
# Local dev:  npm run dev  +  docker compose up -d
# Docker app: docker compose --profile app up -d --build
# Production: docker compose --profile prod up -d --build

# ═══════════════════════════════════════════════════════
# DOCKER COMPOSE — PROFIL (bir marta o'rnatilsa, --profile yozish shart emas)
# ═══════════════════════════════════════════════════════
# Bu o'rnatilsa, oddiy `docker compose up -d --build` va `docker compose down`
# TO'LIQ stack'ni (api, web, nginx...) boshqaradi. Aks holda faqat db/redis/minio
# ko'tariladi (api/web profil ostida bo'lgani uchun).
#   Production serverda:  COMPOSE_PROFILES=prod
#   Docker'da to'liq app (nginxsiz):  COMPOSE_PROFILES=app
#   Lokal dev (api+web'ni o'zingiz npm run dev bilan):  bo'sh qoldiring
COMPOSE_PROFILES=prod

# ═══════════════════════════════════════════════════════
# DOCKER COMPOSE — portlar (host)
# ═══════════════════════════════════════════════════════
POSTGRES_PUBLISH=5433
REDIS_PUBLISH=6379
MINIO_PUBLISH=9000
MINIO_CONSOLE=9001
API_PUBLISH=3001
WEB_PUBLISH=3000
PROMETHEUS_PUBLISH=9090
GRAFANA_PUBLISH=3002
TURN_PUBLISH=3499
TURN_PORT=3499

# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
POSTGRES_USER=ishifo
POSTGRES_PASSWORD=ishifo_secret
POSTGRES_DB=ishifo

# Local npm dev (host → docker postgres)
DATABASE_URL=postgresql://ishifo:ishifo_secret@localhost:5433/ishifo?schema=public

# Docker ichida (api/migrate/seed — host: postgres)
DATABASE_URL_DOCKER=postgresql://ishifo:ishifo_secret@postgres:5432/ishifo?schema=public

# ═══════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

# ═══════════════════════════════════════════════════════
# JWT / AUTH
# ═══════════════════════════════════════════════════════
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false
TRUST_PROXY=false

# ═══════════════════════════════════════════════════════
# AI (OpenAI)
# ═══════════════════════════════════════════════════════
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════
# MinIO / S3
# ═══════════════════════════════════════════════════════
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=ishifo
S3_USE_SSL=false
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ═══════════════════════════════════════════════════════
# FRONTEND / APP
# ═══════════════════════════════════════════════════════
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WEB_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://api:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SOCKET_IO_PATH=/socket.io

# ═══════════════════════════════════════════════════════
# WebRTC / TURN (3499 — app: @turn, prod: @coturn)
# ═══════════════════════════════════════════════════════
# ⚠️ PRODUCTION UCHUN MUHIM — video "qora ekran" muammosi shu yerdan:
#  1) TURN_PUBLIC_URL va NEXT_PUBLIC_TURN_URL "localhost" EMAS, serverning
#     OMMAVIY IP yoki domeni bo'lishi shart. "localhost" = foydalanuvchining
#     o'z kompyuteri, u sizning TURN serveringizga yetmaydi.
#  2) TURN_EXTERNAL_IP — serverning ommaviy IP'si. Docker ichidagi coturn shu
#     IP'ni relay sifatida e'lon qiladi. Bo'lmasa TURN relay ishlamaydi.
#  3) Firewall'da ochiq bo'lsin: 3499/udp, 3499/tcp, 49152-49200/udp
# ── Vaqtinchalik TURN parollari (TAVSIYA ETILADI) ──────────────────
# Bu o'rnatilsa, server har so'rovda 4 soatlik parol yasaydi (TURN REST API).
# Doimiy parol brauzerga umuman uzatilmaydi — sizib chiqsa ham o'z-o'zidan
# yaroqsiz bo'ladi. Kalitni quyidagicha yarating:
#   openssl rand -hex 32
# Bo'sh qoldirilsa — eski doimiy parol rejimi (TURN_USERNAME/TURN_PASSWORD).
TURN_STATIC_SECRET=

TURN_USERNAME=ishifo
TURN_PASSWORD=ishifo_turn_secret
TURN_REALM=ishifo.uz
# ↓↓↓ Bularni serverning OMMAVIY IP yoki domeniga o'zgartiring (masalan turn:203.0.113.10:3499 yoki turn:ishifo.uz:3499)
TURN_PUBLIC_URL=turn:REPLACE_WITH_PUBLIC_IP_OR_DOMAIN:3499
NEXT_PUBLIC_TURN_URL=turn:REPLACE_WITH_PUBLIC_IP_OR_DOMAIN:3499
# ↓↓↓ Serverning OMMAVIY IP'si (coturn relay uchun). Prod'da majburiy.
TURN_EXTERNAL_IP=REPLACE_WITH_PUBLIC_IP
TURN_PUBLIC_USERNAME=ishifo
TURN_PUBLIC_PASSWORD=ishifo_turn_secret
TURN_URL=turn:ishifo:ishifo_turn_secret@turn:3499
NEXT_PUBLIC_TURN_USERNAME=ishifo
NEXT_PUBLIC_TURN_CREDENTIAL=ishifo_turn_secret

# ═══════════════════════════════════════════════════════
# LiveKit SFU (Google Meet uslubi — media server)
# ═══════════════════════════════════════════════════════
#
# PRODUCTION UCHUN MAJBURIY 2 QOIDA (TURN bilan bir xil mantiq):
#  1) LIVEKIT_PUBLIC_URL — brauzer yeta oladigan manzil bo'lishi SHART.
#     "localhost" boshqa qurilmada O'SHA QURILMANI bildiradi -> ulanmaydi.
#     nginx /livekit/ proxy orqali:  wss://ishifo.uz/livekit
#  2) LIVEKIT_NODE_IP — serverning OMMAVIY IP'si. Docker ichidagi LiveKit shu
#     IP'ni media manzili sifatida e'lon qiladi. 127.0.0.1 qolsa media oqmaydi.
#
# Firewall: 50000-50050/udp (media) va 7881/tcp (UDP yopiq tarmoqlar uchun).
#
# Prod misoli:
#   LIVEKIT_PUBLIC_URL=wss://ishifo.uz/livekit
#   LIVEKIT_NODE_IP=203.0.113.10
# true bo'lsa video P2P o'rniga LiveKit orqali o'tadi (qatlamli sifat, qora ekran yo'q).
# Server: docker compose --profile app up -d livekit
# Firewall: 7880/tcp (signaling), 7881/tcp (media fallback), 50000-50050/udp
LIVEKIT_ENABLED=true
LIVEKIT_API_KEY=ishifo_devkey
LIVEKIT_API_SECRET=ishifo_livekit_dev_secret_32chars!!
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_PUBLISH=7880
LIVEKIT_TCP_PUBLISH=7881

# ═══════════════════════════════════════════════════════
# DEV / STAGING
# ═══════════════════════════════════════════════════════
STAGING=false
ALLOW_SEED=true
SWAGGER_ENABLED=true
SHOW_DEV_CREDENTIALS=true
ONEID_MOCK=true
SEED_PASSWORD=password123
E2E=false

# ═══════════════════════════════════════════════════════
# INTEGRATSIYALAR
# ═══════════════════════════════════════════════════════
ONEID_ENABLED=false
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=http://localhost:3001/api/integrations/oneid/callback
ONEID_AUTH_URL=
ONEID_TOKEN_URL=
ONEID_PROFILE_URL=
PRESCRIPTION_ENABLED=false
PRESCRIPTION_API_URL=
PRESCRIPTION_API_KEY=
ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════
# SMTP / SMS / PUSH
# ═══════════════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ishifo.uz
SMS_PROVIDER=mock
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PUSH_PROVIDER=mock

# ═══════════════════════════════════════════════════════
# QURILMALAR / RETENTION
# ═══════════════════════════════════════════════════════
DEVICE_MODE=real
DEVICE_GATEWAY_URL=
DEVICE_GATEWAY_POLL_MS=30000
REAL_DEVICES_JSON=
DATA_RETENTION_DAYS=2555
RETENTION_CRON_ENABLED=false
RETENTION_CRON_INTERVAL_HOURS=24

# ═══════════════════════════════════════════════════════
# MONITORING
# ═══════════════════════════════════════════════════════
METRICS_BEARER_TOKEN=dev-metrics-token
GRAFANA_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
BACKUP_RETENTION_DAYS=14

# ═══════════════════════════════════════════════════════
# PRODUCTION BOOTSTRAP (profile: prod)
# ═══════════════════════════════════════════════════════
ADMIN_BOOTSTRAP_EMAIL=admin@ishifo.uz
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeInProduction!
ADMIN_BOOTSTRAP_NAME=Administrator
UT_FACILITY_CODES=UT-001,UT-002,UT-003,UT-004
MT_FACILITY_NAME=FJSTI Markaziy Shifoxona
MT_FACILITY_ADDRESS=Markaziy telemedicine markazi manzili
MT_FACILITY_PHONE=+998901234567

# ═══════════════════════════════════════════════════════
# NGINX (profile: prod)
# ═══════════════════════════════════════════════════════
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
