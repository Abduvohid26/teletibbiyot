{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=@ishifo/web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--workspace=@ishifo/api"],
      "port": 3001
    },
    {
      "name": "api-livekit",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "E2E_LIVEKIT=true npm run start:dev --workspace=@ishifo/api"],
      "port": 3001
    }
  ]
}
